# Copy to .env.local for local development, or run `pnpm env:local` to generate it
# from the running local Supabase (`pnpm db:start`). Never commit real values.

# Supabase: public values, safe in the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: server only. Bypasses RLS: never expose it to the client.
SUPABASE_SECRET_KEY=
