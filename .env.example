# Copy to .env.local for local development, or run `pnpm env:local` to write it
# from the running local Supabase (`pnpm db:start`); it keeps any other variables,
# e.g. VERCEL_OIDC_TOKEN from `vercel env pull`. Never commit real values.

# Supabase: public values, safe in the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: server only. Bypasses RLS: never expose it to the client.
SUPABASE_SECRET_KEY=

# AI Gateway (server only). Optional: defaults to "anthropic/claude-haiku-4.5".
AI_MODEL=

# Kill switch for AI decomposition (paid model calls): "true" to enable, anything unset is off.
# Enabled on Vercel Preview; Production stays off until per-user quotas ship.
AI_DECOMPOSITION_ENABLED=

# AI Gateway auth: local only (`vercel env pull` or a key from the Gateway dashboard).
# Vercel deployments authenticate via OIDC (VERCEL_OIDC_TOKEN); do not set this in production.
AI_GATEWAY_API_KEY=
